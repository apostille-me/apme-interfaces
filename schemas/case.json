{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apostille-me/apme-interfaces/schemas/case.json",
  "title": "Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "status",
    "created_at",
    "updated_at",
    "client_reference",
    "destination_country",
    "document_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "status": {
      "type": "string",
      "enum": [
        "intake",
        "collecting_documents",
        "review",
        "submitted",
        "completed",
        "closed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_reference": {
      "type": "string"
    },
    "destination_country": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "next_action_due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
